{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "http:default",
  "description": "Capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "sql:allow-close",
    {
      "identifier": "http:default",
      "allow": [
    { "url": "https://**" },
    { "url": "http://localhost:*/**" },
    { "url": "http://127.0.0.1:*/**" }
  ]
    }
  ]
}